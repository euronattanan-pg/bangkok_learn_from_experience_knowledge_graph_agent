# Copy to .env and configure locally. Never send credentials in chat.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Copy model settings to the ignored .env; use --env to load them server-side.
# Local Copilot use is single-user only and also requires --allow-local-copilot.
LFE_MODEL_PROVIDER=manual
LFE_COPILOT_AUTH=local-cli
LFE_COPILOT_MODEL=auto
LFE_COPILOT_TIMEOUT_SECONDS=60
LFE_DEPLOYMENT_MODE=local
