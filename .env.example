# Copy to .env and configure locally. Never send credentials in chat.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Copy these model settings to a separately ignored .env; use --env to load it.
# Copilot stays disabled until SDK/auth and shared-VM protections are verified.
LFE_MODEL_PROVIDER=manual
COPILOT_GITHUB_TOKEN=
